{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ProcessedDataRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::adi-1-3-customer-feedback-269737522732/processed-data/*",
        "arn:aws:s3:::adi-1-3-customer-feedback-269737522732/raw-data/images/*"
      ]
    },
    {
      "Sid": "S3FormattedDataWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::adi-1-3-customer-feedback-269737522732/formatted-data/*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:269737522732:log-group:/aws/lambda/adi-1-3-bedrock-formatting:*"
    }
  ]
}
