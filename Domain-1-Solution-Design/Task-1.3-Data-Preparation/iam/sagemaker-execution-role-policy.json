{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3SurveyDataReadWrite",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::adi-1-3-customer-feedback-269737522732",
        "arn:aws:s3:::adi-1-3-customer-feedback-269737522732/raw-data/surveys/*",
        "arn:aws:s3:::adi-1-3-customer-feedback-269737522732/code/*"
      ]
    },
    {
      "Sid": "S3ProcessedDataWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::adi-1-3-customer-feedback-269737522732/processed-data/surveys/*"
    },
    {
      "Sid": "ECRPullPublicContainer",
      "Effect": "Allow",
      "Action": ["ecr:GetAuthorizationToken", "ecr:BatchCheckLayerAvailability", "ecr:GetDownloadUrlForLayer", "ecr:BatchGetImage"],
      "Resource": "*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:269737522732:log-group:/aws/sagemaker/*"
    }
  ]
}
