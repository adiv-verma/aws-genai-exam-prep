{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ListReviewsPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::adi-1-3-customer-feedback-269737522732",
      "Condition": {
        "StringLike": { "s3:prefix": ["processed-data/reviews/*"] }
      }
    },
    {
      "Sid": "S3GetProcessedReviews",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::adi-1-3-customer-feedback-269737522732/processed-data/reviews/*"
    },
    {
      "Sid": "S3InsightsWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::adi-1-3-customer-feedback-269737522732/insights/*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:269737522732:log-group:/aws/lambda/adi-1-3-theme-aggregation:*"
    }
  ]
}
